{
  "name": "cueflora",
  "version": "0.1.11",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev": "npm run dev:chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "build": "npm run build:chrome",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip": "npm run zip:chrome",
    "submit": "./scripts/release.sh submit",
    "submit:dry-run": "./scripts/release.sh submit --dry-run",
    "release:sign": "./scripts/release.sh sign",
    "release:submit": "./scripts/release.sh submit",
    "release:prepare": "node scripts/prepare.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "pinyin-pro": "^3.28.0"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "@wxt-dev/browser": "0.1.39",
    "@wxt-dev/storage": "1.2.8",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wxt": "0.21.4"
  }
}
